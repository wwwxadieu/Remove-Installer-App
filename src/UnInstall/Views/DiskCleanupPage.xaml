<Page
    x:Class="UnInstall.Views.DiskCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UnInstall.Models"
    xmlns:strings="using:UnInstall.Strings"
    NavigationCacheMode="Enabled">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"
                   Text="{x:Bind strings:AppStrings.DiskCleanup_Title}" />

        <TextBlock Grid.Row="1" Text="{x:Bind strings:AppStrings.DiskCleanup_Subtitle}"
                   Opacity="0.7" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{x:Bind strings:AppStrings.DiskCleanup_DrivesTitle}" FontWeight="SemiBold" FontSize="14" />
            <ItemsControl x:Name="DrivesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DriveSpaceInfo">
                        <Grid ColumnDefinitions="120,*,150" ColumnSpacing="8" Padding="0,4">
                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind UsedPercent}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8" FontSize="12"
                                       Text="{x:Bind DisplayUsedOfTotal}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="ScanButton" Content="{x:Bind strings:AppStrings.DiskCleanup_Scan}" Click="ScanButton_Click" />
            <Button x:Name="SelectAllButton" Content="{x:Bind strings:AppStrings.DiskCleanup_SelectAll}" Click="SelectAllButton_Click" />
            <Button x:Name="ClearSelectionButton" Content="{x:Bind strings:AppStrings.DiskCleanup_ClearSelection}" Click="ClearSelectionButton_Click" />
            <Button x:Name="CleanButton" Content="{x:Bind strings:AppStrings.DiskCleanup_Clean}"
                    Click="CleanButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <Grid Grid.Row="4">
            <ListView x:Name="CategoryListView" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiskCleanupCategory">
                        <Grid ColumnDefinitions="Auto,3*,Auto" Padding="12,8">
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName}" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind DisplaySize}" VerticalAlignment="Center" Opacity="0.8" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyStateText"
                       Text="{x:Bind strings:AppStrings.DiskCleanup_Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,8,0,0" Spacing="4">
            <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" />
            <Grid ColumnDefinitions="Auto,*">
                <ProgressRing x:Name="BusyRing" Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" IsActive="False" />
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
