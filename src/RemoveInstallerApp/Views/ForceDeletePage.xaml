<Page
    x:Class="RemoveInstallerApp.Views.ForceDeletePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RemoveInstallerApp.Models"
    xmlns:strings="using:RemoveInstallerApp.Strings"
    NavigationCacheMode="Enabled">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"
                   Text="{x:Bind strings:AppStrings.ForceDelete_Title}" />

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BrowseFileButton" Content="{x:Bind strings:AppStrings.ForceDelete_BrowseFile}" Click="BrowseFileButton_Click" />
                <Button x:Name="BrowseFolderButton" Content="{x:Bind strings:AppStrings.ForceDelete_BrowseFolder}" Click="BrowseFolderButton_Click" />
                <Button x:Name="DeleteButton" Content="{x:Bind strings:AppStrings.ForceDelete_DeleteButton}"
                        Click="DeleteButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
            <StackPanel Spacing="2">
                <CheckBox x:Name="SecureDeleteCheckBox"
                          Content="{x:Bind strings:AppStrings.ForceDelete_SecureDelete}"
                          Checked="SecureDeleteCheckBox_CheckedChanged"
                          Unchecked="SecureDeleteCheckBox_CheckedChanged" />
                <TextBlock Text="{x:Bind strings:AppStrings.ForceDelete_SecureDeleteDescription}"
                           Opacity="0.7" TextWrapping="Wrap" FontSize="12" MaxWidth="560" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="DropZone" Grid.Row="2" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
            <ListView x:Name="QueueListView" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ForceDeleteQueueItem">
                        <Grid ColumnDefinitions="Auto,1.2*,3*,Auto,Auto" Padding="12,8">
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind KindLabel}" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DisplaySize}" VerticalAlignment="Center" Opacity="0.8" Margin="8,0" />
                            <Button Grid.Column="4" Content="{x:Bind strings:AppStrings.ForceDelete_RemoveFromQueue}"
                                    Tag="{x:Bind}" Click="RemoveQueueItemButton_Click" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyStateText"
                       Text="{x:Bind strings:AppStrings.ForceDelete_Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />

            <TextBlock x:Name="ElevatedDragDropNoticeText"
                       Text="{x:Bind strings:AppStrings.ForceDelete_ElevatedDragDropNotice}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,12"
                       Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" MaxWidth="420"
                       Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
            <ProgressRing x:Name="BusyRing" Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" />
        </Grid>
    </Grid>
</Page>
