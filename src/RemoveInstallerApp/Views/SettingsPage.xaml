<Page
    x:Class="RemoveInstallerApp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="using:RemoveInstallerApp.Strings">

    <StackPanel Spacing="24" MaxWidth="560" HorizontalAlignment="Left">

        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.Settings_Title}" />

        <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.Settings_Language}" />
            <RadioButtons x:Name="LanguageRadioButtons" SelectionChanged="LanguageRadioButtons_SelectionChanged">
                <RadioButton x:Name="EnglishOption" Content="{x:Bind strings:AppStrings.Settings_LanguageEnglish}" Tag="en-US" />
                <RadioButton x:Name="VietnameseOption" Content="{x:Bind strings:AppStrings.Settings_LanguageVietnamese}" Tag="vi-VN" />
            </RadioButtons>
        </StackPanel>

        <StackPanel Spacing="4">
            <ToggleSwitch x:Name="SilentUninstallToggle"
                          Header="{x:Bind strings:AppStrings.Settings_SilentUninstall}"
                          Toggled="SilentUninstallToggle_Toggled" />
            <TextBlock Text="{x:Bind strings:AppStrings.Settings_SilentUninstallDescription}"
                       Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
    </StackPanel>
</Page>
