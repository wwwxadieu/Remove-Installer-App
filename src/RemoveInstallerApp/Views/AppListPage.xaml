<Page
    x:Class="RemoveInstallerApp.Views.AppListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RemoveInstallerApp.Models"
    xmlns:strings="using:RemoveInstallerApp.Strings">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     PlaceholderText="{x:Bind strings:AppStrings.AppList_SearchPlaceholder}"
                     TextChanged="SearchTextBox_TextChanged" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="{x:Bind strings:AppStrings.AppList_Refresh}"
                    Click="RefreshButton_Click" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="3*,2*,1*,1*,Auto" Padding="12,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.AppList_ColumnName}" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.AppList_ColumnPublisher}" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.AppList_ColumnVersion}" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.AppList_ColumnSize}" />
            <TextBlock Grid.Column="4" Width="120" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="AppsListView" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:InstalledAppInfo">
                        <Grid ColumnDefinitions="3*,2*,1*,1*,Auto" Padding="12,8">
                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Publisher}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBlock Grid.Column="2" Text="{x:Bind DisplayVersion}" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DisplaySize}" VerticalAlignment="Center" Opacity="0.8" />
                            <Button Grid.Column="4" Width="120"
                                    Content="{x:Bind strings:AppStrings.AppList_Uninstall}"
                                    Click="UninstallButton_Click"
                                    Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyStateText"
                       Text="{x:Bind strings:AppStrings.AppList_Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
            <ProgressRing x:Name="BusyRing" Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" />
        </Grid>
    </Grid>
</Page>
