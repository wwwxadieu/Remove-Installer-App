<ContentDialog
    x:Class="ClearOut.Views.RestorePointsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClearOut.Models"
    xmlns:strings="using:ClearOut.Strings"
    CloseButtonText="{x:Bind strings:AppStrings.Common_Close}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" MinWidth="480" MinHeight="340">

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{x:Bind strings:AppStrings.RestorePoints_Intro}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="CreateButton" Content="{x:Bind strings:AppStrings.RestorePoints_CreateNew}" Click="CreateButton_Click" />
            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid x:Name="ListPanel" Grid.Row="3">
            <ListView x:Name="PointsListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RestorePointInfo">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="8,6">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind DisplayCreationTime}" Opacity="0.6" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center"
                                    Content="{x:Bind strings:AppStrings.RestorePoints_RestoreButton}"
                                    Click="RestoreButton_Click" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyStateText"
                       Text="{x:Bind strings:AppStrings.RestorePoints_Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="360" />
        </Grid>

        <StackPanel x:Name="ConfirmPanel" Grid.Row="3" Visibility="Collapsed" Spacing="8">
            <TextBlock x:Name="ConfirmText" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <Button x:Name="BackToListButton" Content="{x:Bind strings:AppStrings.Common_Cancel}" Click="BackToListButton_Click" />
        </StackPanel>
    </Grid>
</ContentDialog>
