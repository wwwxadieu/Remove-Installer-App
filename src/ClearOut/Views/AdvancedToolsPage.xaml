<Page
    x:Class="ClearOut.Views.AdvancedToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClearOut.Models"
    xmlns:strings="using:ClearOut.Strings"
    NavigationCacheMode="Enabled">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16">

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"
                   Text="{x:Bind strings:AppStrings.AdvancedTools_Title}" />
        <TextBlock Grid.Row="1" Text="{x:Bind strings:AppStrings.AdvancedTools_Subtitle}"
                   Opacity="0.7" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />

        <Pivot Grid.Row="2">

            <!-- Startup Apps -->
            <PivotItem Header="{x:Bind strings:AppStrings.AdvancedTools_TabStartupApps}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                        <Button Content="{x:Bind strings:AppStrings.AdvancedTools_Refresh}" Click="RefreshStartupApps_Click" />
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingStartupApps, Mode=OneWay}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListView x:Name="StartupAppsListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:StartupAppInfo">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="8,6">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Command}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                                                   Text="{x:Bind LocationLabel}" />
                                        <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" OnContent="" OffContent=""
                                                      IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                                      Toggled="StartupToggle_Toggled" Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="StartupAppsEmptyText"
                                   Text="{x:Bind strings:AppStrings.AdvancedTools_StartupApps_Empty}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.6" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Services -->
            <PivotItem Header="{x:Bind strings:AppStrings.AdvancedTools_TabServices}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                        <Button Content="{x:Bind strings:AppStrings.AdvancedTools_Refresh}" Click="RefreshServices_Click" />
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingServices, Mode=OneWay}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListView x:Name="ServicesListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:WindowsServiceInfo">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" Padding="8,6">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                                                   Text="{x:Bind StartTypeLabel}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                                                   Text="{x:Bind StatusLabel}" />
                                        <Button Grid.Column="3" VerticalAlignment="Center"
                                                Content="{x:Bind ServiceActionLabel}"
                                                IsEnabled="{x:Bind CanPerformAction}"
                                                Click="ServiceActionButton_Click" Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ServicesEmptyText"
                                   Text="{x:Bind strings:AppStrings.AdvancedTools_Services_Empty}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.6" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Processes -->
            <PivotItem Header="{x:Bind strings:AppStrings.AdvancedTools_TabProcesses}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                        <Button Content="{x:Bind strings:AppStrings.AdvancedTools_Refresh}" Click="RefreshProcesses_Click" />
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoadingProcesses, Mode=OneWay}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ListView x:Name="ProcessesListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RunningProcessInfo">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="8,6">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                                                   Text="{x:Bind DisplayMemory}" />
                                        <Button Grid.Column="2" VerticalAlignment="Center"
                                                Content="{x:Bind strings:AppStrings.AdvancedTools_KillButton}"
                                                Click="KillProcessButton_Click" Tag="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ProcessesEmptyText"
                                   Text="{x:Bind strings:AppStrings.AdvancedTools_Processes_Empty}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.6" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
