<ContentDialog
    x:Class="ClearOut.Views.PostUninstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClearOut.Models"
    xmlns:strings="using:ClearOut.Strings">

    <Grid RowDefinitions="Auto,Auto,*" MinWidth="520" MinHeight="220">

        <TextBlock x:Name="ResultText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- Scan phase: a determinate bar plus the step being examined, so the user can see
             the workflow rather than an unexplained spinner. -->
        <StackPanel x:Name="ScanPanel" Grid.Row="1" Spacing="6" Margin="0,0,0,8">
            <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" />
            <TextBlock x:Name="ScanStatusText" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Results phase -->
        <Grid x:Name="ResultsPanel" Grid.Row="2" Visibility="Collapsed" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button x:Name="SelectAllButton" Content="{x:Bind strings:AppStrings.Residue_SelectAll}" Click="SelectAllButton_Click" />
                <Button x:Name="ClearSelectionButton" Content="{x:Bind strings:AppStrings.Residue_ClearSelection}" Click="ClearSelectionButton_Click" />
            </StackPanel>

            <ListView x:Name="ResidueListView" Grid.Row="1" SelectionMode="None" MaxHeight="280">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ResidueItem">
                        <Grid ColumnDefinitions="Auto,1.2*,3*,Auto" Padding="8,6">
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind KindLabel}" VerticalAlignment="Center" Opacity="0.8" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{x:Bind DisplaySize}" VerticalAlignment="Center" Opacity="0.8" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</ContentDialog>
