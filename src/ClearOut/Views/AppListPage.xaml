<Page
    x:Class="ClearOut.Views.AppListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClearOut.Models"
    xmlns:strings="using:ClearOut.Strings"
    xmlns:converters="using:ClearOut.Converters"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToRowHighlightConverter x:Key="BoolToRowHighlightConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     PlaceholderText="{x:Bind strings:AppStrings.AppList_SearchPlaceholder}"
                     TextChanged="SearchTextBox_TextChanged" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="{x:Bind strings:AppStrings.AppList_Refresh}"
                    Click="RefreshButton_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="SelectAllButton" Content="{x:Bind strings:AppStrings.AppList_SelectAll}" Click="SelectAllButton_Click" />
            <Button x:Name="ClearSelectionButton" Content="{x:Bind strings:AppStrings.AppList_ClearSelection}" Click="ClearSelectionButton_Click" />
            <Button x:Name="UninstallSelectedButton" Content="{x:Bind strings:AppStrings.AppList_UninstallSelected}" Click="UninstallSelectedButton_Click" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,3*,2*,1*,1*,Auto" Padding="12,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Grid.Column="0" Width="20" />
            <TextBlock Grid.Column="1" Width="20" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.AppList_ColumnName}" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.AppList_ColumnPublisher}" />
            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.AppList_ColumnVersion}" />
            <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="{x:Bind strings:AppStrings.AppList_ColumnSize}" />
            <TextBlock Grid.Column="6" Width="44" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="AppsListView" SelectionMode="None" Visibility="Collapsed"
                      DoubleTapped="AppsListView_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:InstalledAppInfo">
                        <!-- Background must always be a real (even if transparent) brush, never unset -
                             a Panel with no Background only receives pointer input where a child element
                             already covers the pixels, which is what silently broke both right-click
                             (ContextFlyout) and row selection anywhere off the checkbox/text glyphs.
                             BoolToRowHighlightConverter's "false" branch returns Colors.Transparent
                             (not null) for exactly this reason, while also tinting the row when
                             IsSelected is true so a selected app is visible at a glance. -->
                        <Grid ColumnDefinitions="Auto,Auto,3*,2*,1*,1*,Auto" Padding="12,8"
                              Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToRowHighlightConverter}}"
                              Tapped="AppRow_Tapped">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind strings:AppStrings.AppList_ContextMenuUninstall}"
                                                     Click="ContextMenuUninstall_Click"
                                                     Tag="{x:Bind}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      DoubleTapped="SelectionCheckBox_DoubleTapped" />
                            <Image Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center"
                                   Source="{x:Bind IconSource, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Publisher}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBlock Grid.Column="4" Text="{x:Bind DisplayVersion}" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBlock Grid.Column="5" Text="{x:Bind DisplaySize}" VerticalAlignment="Center" Opacity="0.8" />
                            <Button Grid.Column="6" Padding="8,6" VerticalAlignment="Center"
                                    Click="UninstallButton_Click"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind strings:AppStrings.AppList_Uninstall}"
                                    AutomationProperties.Name="{x:Bind strings:AppStrings.AppList_Uninstall}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyStateText"
                       Text="{x:Bind strings:AppStrings.AppList_Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
            <ProgressRing x:Name="BusyRing" Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" />
        </Grid>
    </Grid>
</Page>
