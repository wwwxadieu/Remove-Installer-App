<ContentDialog
    x:Class="ClearOut.Views.DiskHealthDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClearOut.Models"
    xmlns:strings="using:ClearOut.Strings"
    xmlns:converters="using:ClearOut.Converters"
    CloseButtonText="{x:Bind strings:AppStrings.Common_Close}">

    <ContentDialog.Resources>
        <converters:DiskHealthStatusToBrushConverter x:Key="DiskHealthStatusToBrushConverter" />
    </ContentDialog.Resources>

    <Grid RowDefinitions="Auto,Auto,*" MinWidth="420" MinHeight="280">

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{x:Bind strings:AppStrings.DiskHealth_Intro}" />

        <ProgressRing x:Name="BusyRing" Grid.Row="1" Width="18" Height="18" HorizontalAlignment="Left"
                      Margin="0,0,0,8" IsActive="False" />

        <Grid Grid.Row="2">
            <ListView x:Name="DisksListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiskHealthInfo">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="8,6">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{x:Bind DiskModel}" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" VerticalAlignment="Center"
                                    CornerRadius="10" Padding="10,3"
                                    Background="{x:Bind Status, Converter={StaticResource DiskHealthStatusToBrushConverter}}">
                                <TextBlock Text="{x:Bind StatusLabel}" Foreground="White" FontSize="12" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyStateText"
                       Text="{x:Bind strings:AppStrings.DiskHealth_Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="360" />
        </Grid>
    </Grid>
</ContentDialog>
