<Page
    x:Class="ClearOut.Views.DeviceSpecsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClearOut.Models"
    xmlns:strings="using:ClearOut.Strings"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <StackPanel Margin="0,0,16,16" Spacing="4">

            <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="{x:Bind strings:AppStrings.DeviceSpecs_Title}" />

            <TextBlock Text="{x:Bind strings:AppStrings.DeviceSpecs_Subtitle}"
                       Opacity="0.7" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />

            <TextBlock Text="{x:Bind strings:AppStrings.DeviceSpecs_SectionOS}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,0,0,16">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind strings:AppStrings.DeviceSpecs_OsEdition}" Opacity="0.7" />
                <TextBlock x:Name="OsNameText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind strings:AppStrings.DeviceSpecs_OsVersion}" Opacity="0.7" />
                <TextBlock x:Name="OsVersionText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind strings:AppStrings.DeviceSpecs_Architecture}" Opacity="0.7" />
                <TextBlock x:Name="ArchitectureText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Bind strings:AppStrings.DeviceSpecs_ComputerName}" Opacity="0.7" />
                <TextBlock x:Name="ComputerNameText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>

            <TextBlock Text="{x:Bind strings:AppStrings.DeviceSpecs_SectionHardware}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,0,0,16">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind strings:AppStrings.DeviceSpecs_Processor}" Opacity="0.7" />
                <TextBlock x:Name="CpuText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind strings:AppStrings.DeviceSpecs_Cores}" Opacity="0.7" />
                <TextBlock x:Name="CoresText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind strings:AppStrings.DeviceSpecs_InstalledMemory}" Opacity="0.7" />
                <TextBlock x:Name="RamText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Bind strings:AppStrings.DeviceSpecs_Manufacturer}" Opacity="0.7" />
                <TextBlock x:Name="ManufacturerText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Bind strings:AppStrings.DeviceSpecs_Model}" Opacity="0.7" />
                <TextBlock x:Name="ModelText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>

            <TextBlock Text="{x:Bind strings:AppStrings.DiskCleanup_DrivesTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
            <ItemsControl x:Name="DrivesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DriveSpaceInfo">
                        <Grid ColumnDefinitions="120,*,150" ColumnSpacing="8" Padding="0,4">
                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind UsedPercent}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8" FontSize="12"
                                       Text="{x:Bind DisplayUsedOfTotal}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
