<Page
    x:Class="ClearOut.Views.ResidueScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClearOut.Models"
    xmlns:strings="using:ClearOut.Strings"
    NavigationCacheMode="Enabled">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"
                   Text="{x:Bind strings:AppStrings.Residue_Title}" />

        <TextBlock Grid.Row="1" Text="{x:Bind strings:AppStrings.Residue_Subtitle}"
                   Opacity="0.7" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="ScanOrphansButton" Content="{x:Bind strings:AppStrings.Residue_ScanOrphans}" Click="ScanOrphansButton_Click" />
            <Button x:Name="SelectAllButton" Content="{x:Bind strings:AppStrings.Residue_SelectAll}" Click="SelectAllButton_Click" />
            <Button x:Name="ClearSelectionButton" Content="{x:Bind strings:AppStrings.Residue_ClearSelection}" Click="ClearSelectionButton_Click" />
            <Button x:Name="DeleteSelectedButton" Content="{x:Bind strings:AppStrings.Residue_DeleteSelected}"
                    Click="DeleteSelectedButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <Grid Grid.Row="3">
            <ListView x:Name="ResidueListView" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ResidueItem">
                        <Grid ColumnDefinitions="Auto,1.2*,3*,Auto" Padding="12,8">
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind KindLabel}" VerticalAlignment="Center" Opacity="0.8" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{x:Bind DisplaySize}" VerticalAlignment="Center" Opacity="0.8" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyStateText"
                       Text="{x:Bind strings:AppStrings.Residue_Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
            <ProgressRing x:Name="BusyRing" Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" />
        </Grid>
    </Grid>
</Page>
