<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClearOut</RootNamespace>
    <AssemblyName>ClearOut</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Unpackaged (no MSIX) so it can be built/run without an appx identity. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!--
      EnableMsixTooling is deliberately left unset (its own default is false, and
      packaging is off via WindowsPackageType=None either way). Note this property
      does NOT decide whether the MrtCore PRI targets get imported — those resolve
      their MSBuild tasks from a Visual Studio-only folder regardless, so CI passes
      an explicit PriProjTaskAssembly path instead. See .github/workflows/release-beta.yml.
    -->
    <UseRidGraph>true</UseRidGraph>

    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Bumped on release; the update checker compares this against the latest GitHub release tag. -->
    <Version>1.0.0</Version>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <!-- FileSystemAclExtensions (GetAccessControl/SetAccessControl on FileInfo/DirectoryInfo) used
         by Helpers/ForceDelete.cs to take ownership of locked files before retrying deletion. -->
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <!-- WMI (System.Management.ManagementObject etc.) used by SystemRestoreBackupService for
         listing/restoring System Restore points - there is no fully-managed .NET API for either,
         unlike everywhere else in this app where WMI/P-Invoke is deliberately avoided. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- logo.svg is the vector master (not needed at runtime); app.ico is generated from it via
         tools/generate_icon.py and copied to the publish output for the taskbar/Explorer icon.
         Removed from the SDK's default implicit "None" glob first so it isn't listed under two
         item types at once. -->
    <None Remove="Assets\app.ico" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The Windows App SDK generates the app's PRI into $(TargetDir) as $(ProjectPriFileName),
    but only adds it to the output items when AppxPackage=='true' (i.e. an MSIX build).
    This app is unpackaged, so `dotnet publish` left the publish folder without any
    app-level PRI and WinUI could not resolve ms-appx resources at startup.
    Copy it across under both the generated name and the resources.pri name the
    unpackaged loader looks for.
  -->
  <Target Name="CopyProjectPriToPublishOutput"
          AfterTargets="Publish"
          Condition="'$(ProjectPriFullPath)' != '' And Exists('$(ProjectPriFullPath)')">
    <Copy SourceFiles="$(ProjectPriFullPath)"
          DestinationFiles="$(PublishDir)resources.pri"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectPriFullPath)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied app PRI '$(ProjectPriFullPath)' into $(PublishDir)" />
  </Target>

</Project>
